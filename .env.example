# Copie para ".env" e preencha. Nunca commite o .env.

# Obrigatória. Postgres local (docker compose up -d db) ou gratuito no Neon.
# Com "docker compose up --build" o compose usa o próprio banco e ignora esta linha.
DATABASE_URL="postgresql://tracker:tracker@localhost:5433/tracker"

# Obrigatórias fora do modo demonstração. Sem elas o app recusa todas as requisições.
# Gere o segredo com: openssl rand -hex 32
# Se a senha tiver o caractere $, coloque o valor entre aspas simples (o compose interpreta o $ dentro de aspas duplas).
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Só se você acessar o app por HTTP puro fora do localhost (sem HTTPS na frente): o cookie de sessão
# deixa de levar "Secure", senão o navegador o descarta e o login volta para a entrada.
# Atrás de HTTPS, deixe de fora. Exceção: no docker compose o padrão é "true", então atrás de HTTPS
# defina COOKIE_SEM_HTTPS=false.
# COOKIE_SEM_HTTPS=true

# Só se o app ficar atrás do seu próprio proxy (nginx, Caddy): passa a confiar no cabeçalho x-real-ip
# para o limite de tentativas de login. Sem proxy, deixe de fora, senão o cliente pode forjar o IP.
# TRUST_PROXY=true

# Modo demonstração: somente leitura, sem login, para o link público com dados fictícios.
# DEMO_MODE=true

# Opcional: botão "Avaliar com IA" na redação. Chave gratuita em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.7-flash"
# AVALIACOES_POR_DIA=20

# Opcional: sincronização do plano de estudo com uma database do Notion. Passo a passo: docs/integracoes/notion.md
# NOTION_TOKEN: segredo da integração interna (começa com ntn_ ou secret_). Trate como senha.
# NOTION_DATABASE_ID: os 32 caracteres antes de ?v= no link da database (aceita o link inteiro).
NOTION_TOKEN=""
NOTION_DATABASE_ID=""
